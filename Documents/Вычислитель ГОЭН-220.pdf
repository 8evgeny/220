[4], quads[6]\)\);                \r\n    var qRight = Math.max\(Math.max\(quads[0], quads[2]\), Math.max\(quads[4], quads[6]\)\);               \r\n    var qTop = Math.min\(Math.min\(quads[1], quads[3]\), Math.min\(quads[5], quads[7]\\)\);                 \r\n    var qBottom = Math.max\(Math.max\(quads[1], quads[3]\), Math.max\(quads[5], quads[7]\)\);              \r\n    if \(\(left >= qRight\) || \(right <= qLeft\) || \(top >= qBottom\) || \(bottom <= qTop\)\) continue;      \r\n   \ var dist =   Math.abs\(left - qLeft\) + Math.abs\(right - qRight\)                                   \r\n               + Math.abs\(top - qTop\) + Math.abs\(bottom - qBottom\);                                  \r\n    if \(\(lastDist >= 0\) && \(lastDist\ <= dist\)\) continue;                                             \r\n    lastDist = dist;                                                                                 \r\n    lastIndex = i;                                                             \                      \r\n}                                                                                                    \r\nif \(lastIndex >= 0\) this.selectPageNthWord\(pageIndex, lastIndex, bScroll=false\);                     })/S/JavaScript>>endobj1306 0 obj<</JS(function ShowCompProps_B5DCF486BAF14525AA190CC600E4A65D\(\){var sChoice = app.popUpMenu\("Comment: C0603","Component Kind: Standard","Created: Sergey_2","Description: ","Footprint: CAP0603","Footprint Path: Capacitors.PcbLib","Footprint Ref: CAP0603","Ibi\s Model: ","Library Name: Capacitors.SchLib","Library Path: Capacitors.SchLib","Library Ref: C0603","Library Reference: C0603","Manufacture Part Number: ","Part Number: ","PCB3D: ","Pin Info: ","Signal Integrity: ","Simulation: ","Value: NO \(0.1uF\)","Va\lue2: ","Variant2: ","Zamena: ","\\u041A\\u041E\\u0414: ","\\u041D\\u0430\\u0438\\u043C\\u0435\\u043D\\u043E\\u0432\\u0430\\u043D\\u0438\\u0435: ","\\u041F\\u0440\\u043E\\u0438\\u0437\\u0432\\u043E\\u0