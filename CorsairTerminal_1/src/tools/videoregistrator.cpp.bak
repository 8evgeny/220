#include "videoregistrator.h"

using namespace cv;

#include <ctime>
#include <ostream>
#include <cstdio>
#include <dirent.h>
#include <opencv2/core/utils/filesystem.hpp>
#include <algorithm>

static std::string get_datetime()
{
    time_t t = time(nullptr);
    struct tm * now = localtime(&t);
    std::ostringstream os;
    os << now->tm_year + 1900 << "_" << std::setw(2) << std::setfill('0') << now->tm_mon << "_" << std::setw(2) << std::setfill('0')  << now->tm_mday << "_" << std::setw(2) << std::setfill('0') << now->tm_hour << "_" << std::setw(2) << std::setfill('0') << now->tm_min << "_" << std::setw(2) << std::setfill('0') << now->tm_sec;
    return os.str();
}
static std::string get_extention(const std::string & file_name)
{
    std::stringstream test(file_name);
    std::string segment;
    std::vector<std::string> seglist;
    while(std::getline(test, segment, '.'))
    {
       seglist.push_back(segment);
    }
    return seglist.back();
}
static std::vector<std::string> get_existing_video_files(const std::string & path)
{
    std::vector<std::string> files;
    std::shared_ptr<DIR> directory_ptr(opendir(path.c_str()), [](DIR* dir){ dir && closedir(dir); });
    struct dirent * dirent_ptr;
    if(!directory_ptr)
    {
        return files;
    }

    while((dirent_ptr = readdir(directory_ptr.get())) != nullptr)
    {
        std::string file_name = std::string(dirent_ptr->d_name);
        if(get_extention(file_name) == "mp4")
        {
            files.push_back(path + "/" + file_name);
        }
    }
    return files;
}

VideoRegistrator::VideoRegistrator(const std::string & path, const std::string & file_name_prefix,
                                   const Size & size, const int & fourcc, const int & fps,
                                   const int & len_sec, const int & max_cnt):
    _path(path),
    _file_name_prefix(file_name_prefix),
    _size(size),
    _fourcc(fourcc),
    _fps(fps),
    _len_sec(len_sec),
    _len(len_sec * fps),
    _max_cnt(max_cnt),
    cur_len(len_sec * fps)
{
    cv::utils::fs::createDirectory(path);
    std::vector<std::string> existing_records = get_existing_video_files(_path);
    std::sort(existing_records.begin(), existing_records.end());
    for(size_t i = 0; i < existing_records.size(); ++i)
    {
        records.push(existing_records[i]);
        if(records.size() > size_t(_max_cnt))
        {
            std::string file_name = records.front();
            remove(file_name.c_str());
            records.pop();
        }
    }
}
VideoWriter& VideoRegistrator::operator << (const Mat & image)
{
    if((cur_len == _len) && isOpened())
    {
        release();
    }
    if(!isOpened())
    {
        cur_len = 0;
        if(records.size() == size_t(_max_cnt))
        {
            std::string file_name = records.front();
            remove(file_name.c_str());
            records.pop();
        }
        std::string file_name = get_video_filename();
        records.push(file_name);
        open(get_video_filename(), _fourcc, _fps, _size);
    }
    ++cur_len;
    if( (image.cols != _size.width) || (image.rows != _size.height) )
    {
        Mat scaled_image;
        resize(image, scaled_image, _size);
        return VideoWriter::operator<<(scaled_image);
    }
    return VideoWriter::operator<<(image);
}
void VideoRegistrator::save_image(const cv::Mat & image)
{
    cv::imwrite(get_image_filename(), image);
}
std::string VideoRegistrator::get_video_filename()
{
    std::ostringstream os;
    os << _path << "/" << _file_name_prefix << "_" << get_datetime() << ".mp4";
    std::string file_name = os.str();
    return file_name;
}
std::string VideoRegistrator::get_image_filename()
{
    std::ostringstream os;
    os << _path << "/" << _file_name_prefix << "_" << get_datetime() << ".jpg";
    std::string file_name = os.str();
    return file_name;
}
