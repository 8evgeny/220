Кросскомпиляция Проект Qt, CMake  host: x86 ubuntu 22  target: arm64 folder sysroot: /home/user/sysroot_arm64  folder Qt libs for Arm64 : /home/user/stage

Duck.ai said


Ниже пример для Ubuntu 22.04 x86_64 → Linux ARM64/aarch64, где:

sysroot: /home/user/sysroot_arm64
Qt для ARM64: /home/user/stage
компилятор: aarch64-linux-gnu-gcc/g++
проект использует CMake и Qt 6
Qt при кросс-компиляции должен находить именно ARM64-библиотеки, а инструменты moc, rcc, qmlcachegen и другие — 
запускаться с host-машины. Для Qt 6 желательно использовать qt.toolchain.cmake, созданный при сборке Qt, 
либо отдельный toolchain-файл. Версии host Qt и target Qt должны совпадать.

qt.io

1. Установите ARM64-компилятор
bash


sudo apt update
sudo apt install \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    binutils-aarch64-linux-gnu \
    cmake \
    ninja-build \
    pkg-config
Проверьте:

bash


aarch64-linux-gnu-gcc --version
aarch64-linux-gnu-g++ --version
В sysroot должны присутствовать примерно такие каталоги:

text


/home/user/sysroot_arm64/usr/include
/home/user/sysroot_arm64/usr/lib
/home/user/sysroot_arm64/lib
Проверьте архитектуру Qt-библиотеки:

bash


file /home/user/stage/lib/libQt6Core.so
Ожидаемый результат должен содержать:

text


ARM aarch64
Также желательно проверить наличие CMake-конфигурации Qt:

bash


find /home/user/stage -path '*Qt6Config.cmake'
Обычно файл находится здесь:

text

/home/user/stage/lib/cmake/Qt6/Qt6Config.cmake

2. Создайте `toolchain-arm64.cmake
Например:

cmake


# toolchain-arm64.cmake

set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

set(TARGET_SYSROOT "/home/user/sysroot_arm64")
set(TARGET_QT     "/home/user/stage")

set(CMAKE_SYSROOT "${TARGET_SYSROOT}")

set(CMAKE_C_COMPILER   "/usr/bin/aarch64-linux-gnu-gcc")
set(CMAKE_CXX_COMPILER "/usr/bin/aarch64-linux-gnu-g++")
set(CMAKE_ASM_COMPILER "/usr/bin/aarch64-linux-gnu-gcc")

set(CMAKE_AR      "/usr/bin/aarch64-linux-gnu-ar")
set(CMAKE_RANLIB  "/usr/bin/aarch64-linux-gnu-ranlib")
set(CMAKE_STRIP   "/usr/bin/aarch64-linux-gnu-strip")
set(CMAKE_NM      "/usr/bin/aarch64-linux-gnu-nm")
set(CMAKE_OBJCOPY "/usr/bin/aarch64-linux-gnu-objcopy")

# Где искать target-библиотеки, заголовки и Qt
set(CMAKE_FIND_ROOT_PATH
    "${TARGET_SYSROOT}"
    "${TARGET_QT}"
)

# Программы выполняются на host x86_64
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)

# Библиотеки, заголовки и пакеты ищутся в target root
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

# Qt ARM64
set(CMAKE_PREFIX_PATH
    "${TARGET_QT}"
    "${TARGET_SYSROOT}/usr"
    "${TARGET_SYSROOT}/usr/local"
    CACHE STRING "Target package prefixes"
)

# pkg-config не должен брать host-библиотеки
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${TARGET_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR}
    "${TARGET_SYSROOT}/usr/lib/aarch64-linux-gnu/pkgconfig:${TARGET_SYSROOT}/usr/lib/pkgconfig:${TARGET_SYSROOT}/usr/share/pkgconfig"
)

# Не запускать target-бинарники во время конфигурации
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

# Полезно для поиска зависимостей при линковке
set(CMAKE_EXE_LINKER_FLAGS_INIT
    "-Wl,-rpath-link,${TARGET_SYSROOT}/lib/aarch64-linux-gnu \
     -Wl,-rpath-link,${TARGET_SYSROOT}/usr/lib/aarch64-linux-gnu \
     -Wl,-rpath-link,${TARGET_QT}/lib"
)

set(CMAKE_SHARED_LINKER_FLAGS_INIT
    "-Wl,-rpath-link,${TARGET_SYSROOT}/lib/aarch64-linux-gnu \
     -Wl,-rpath-link,${TARGET_SYSROOT}/usr/lib/aarch64-linux-gnu \
     -Wl,-rpath-link,${TARGET_QT}/lib"
)


Если в вашем sysroot библиотеки находятся не в usr/lib/aarch64-linux-gnu, а, например, непосредственно в usr/lib, скорректируйте пути rpath-link и PKG_CONFIG_LIBDIR.





3. Минимальный `CMakeLists.txt
Для Qt 6:

cmake


cmake_minimum_required(VERSION 3.16)

project(TestArm64Qt LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

find_package(Qt6 REQUIRED COMPONENTS Core Gui Widgets)

qt_add_executable(TestArm64Qt
    main.cpp
)

target_link_libraries(TestArm64Qt
    PRIVATE
        Qt6::Core
        Qt6::Gui
        Qt6::Widgets
)

install(TARGETS TestArm64Qt
    RUNTIME DESTINATION bin
)
main.cpp:

cpp


#include <QApplication>
#include <QLabel>

int main(int argc, char *argv[])
{
    QApplication app(argc, argv);

    QLabel label("Hello from ARM64 Qt");
    label.resize(400, 100);
    label.show();

    return app.exec();
}

4. Конфигурация и сборка
Из каталога проекта:

bash


rm -rf build-arm64

cmake -S . \
      -B build-arm64 \
      -G Ninja \
      -DCMAKE_TOOLCHAIN_FILE=/home/user/toolchain-arm64.cmake \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_PREFIX_PATH=/home/user/stage
      
      
Проверьте, что CMake нашёл ARM64 Qt:

bash


grep -E 'Qt6_DIR|CMAKE_CXX_COMPILER|CMAKE_SYSROOT' \
    build-arm64/CMakeCache.txt
Сборка:

bash


cmake --build build-arm64 --parallel
Проверка результата:

bash


file build-arm64/TestArm64Qt
Ожидается:

text


ELF 64-bit LSB pie executable, ARM aarch64
Дополнительно:

bash


aarch64-linux-gnu-readelf -d build-arm64/TestArm64Qt | grep NEEDED
5. Установка и запуск на ARM64-устройстве
Установка в локальную staging-директорию:

bash


rm -rf package-arm64

cmake --install build-arm64 \
      --prefix /home/user/package-arm64
Скопируйте приложение и Qt-библиотеки на target:

bash


scp -r /home/user/package-arm64 user@TARGET_IP:/opt/testqt/
scp -r /home/user/stage/lib/libQt6*.so* user@TARGET_IP:/opt/testqt/lib/
На ARM64-устройстве:

bash


export LD_LIBRARY_PATH=/opt/testqt/lib:$LD_LIBRARY_PATH
/opt/testqt/bin/TestArm64Qt
Для Qt-плагинов, например платформенного плагина xcb, также понадобится каталог:

bash


/opt/testqt/plugins/platforms
Запуск:

bash


export QT_PLUGIN_PATH=/opt/testqt/plugins
export LD_LIBRARY_PATH=/opt/testqt/lib:$LD_LIBRARY_PATH

/opt/testqt/bin/TestArm64Qt
Если используется framebuffer, EGLFS или Wayland, соответствующий Qt-плагин должен быть собран и скопирован в plugins/platforms.

6. Предпочтительный вариант для Qt 6
Если /home/user/stage — полноценная target-установка Qt 6, проверьте наличие:

bash


ls /home/user/stage/lib/cmake/Qt6/qt.toolchain.cmake
Если файл существует, лучше использовать его:

bash


rm -rf build-arm64

cmake -S . \
      -B build-arm64 \
      -G Ninja \
      -DCMAKE_TOOLCHAIN_FILE=/home/user/stage/lib/cmake/Qt6/qt.toolchain.cmake \
      -DQT_CHAINLOAD_TOOLCHAIN_FILE=/home/user/toolchain-arm64.cmake \
      -DCMAKE_BUILD_TYPE=Release
Либо сначала укажите собственный toolchain, а Qt-путь передайте отдельно:

bash


cmake -S . \
      -B build-arm64 \
      -G Ninja \
      -DCMAKE_TOOLCHAIN_FILE=/home/user/toolchain-arm64.cmake \
      -DQt6_DIR=/home/user/stage/lib/cmake/Qt6 \
      -DCMAKE_BUILD_TYPE=Release
Главное — не использовать host-путь вроде /usr/lib/x86_64-linux-gnu/cmake/Qt6, иначе CMake может попытаться связать ARM64-приложение с x86_64 Qt-библиотеками.
